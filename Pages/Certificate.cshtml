@page
@model SkillAssessmentSystem.Pages.CertificateModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Certificate - SkillCert</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #eef2f7;
            color: #111827;
        }

        .topbar {
            background: #111827;
            color: white;
            padding: 18px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
        }

        .logo span {
            color: #60a5fa;
        }

        .topbar a {
            color: white;
            text-decoration: none;
            background: #2563eb;
            padding: 10px 18px;
            border-radius: 7px;
        }

        .page {
            padding: 45px 20px;
        }

        .certificate {
            max-width: 900px;
            margin: auto;
            background: white;
            border: 10px solid #1e3a8a;
            padding: 50px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
        }

        .certificate-inner {
            border: 2px solid #2563eb;
            padding: 45px 30px;
        }

        .trophy {
            font-size: 50px;
        }

        .certificate h1 {
            color: #1e3a8a;
            font-size: 38px;
            margin: 10px 0;
        }

        .subtitle {
            font-size: 20px;
            color: #6b7280;
            margin-bottom: 30px;
        }

        .student-name {
            font-size: 34px;
            font-weight: bold;
            color: #111827;
            margin: 25px 0;
        }

        .description {
            font-size: 18px;
            color: #4b5563;
            line-height: 1.7;
        }

        .assessment {
            font-size: 26px;
            font-weight: bold;
            color: #2563eb;
            margin: 20px 0;
        }

        .score {
            font-size: 20px;
            margin: 20px 0;
        }

        .details {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-top: 40px;
            text-align: left;
        }

        .detail {
            flex: 1;
            background: #f3f4f6;
            padding: 15px;
            border-radius: 8px;
        }

        .detail strong {
            display: block;
            margin-bottom: 7px;
        }

        .buttons {
            margin-top: 30px;
            text-align: center;
        }

        .btn {
            display: inline-block;
            padding: 12px 22px;
            margin: 5px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: bold;
            border: none;
            cursor: pointer;
        }

        .print-btn {
            background: #2563eb;
            color: white;
        }

        .back-btn {
            background: #374151;
            color: white;
        }

        @@media print {

            .topbar,
            .buttons {
                display: none;
            }

            body {
                background: white;
            }

            .page {
                padding: 0;
            }

            .certificate {
                box-shadow: none;
                max-width: none;
            }
        }

        @@media (max-width: 700px) {

            .topbar {
                padding: 15px 20px;
            }

            .certificate {
                padding: 20px;
                border-width: 5px;
            }

            .certificate-inner {
                padding: 30px 15px;
            }

            .certificate h1 {
                font-size: 28px;
            }

            .student-name {
                font-size: 25px;
            }

            .details {
                flex-direction: column;
            }
        }

    </style>

</head>

<body>

    <div class="topbar">

        <div class="logo">
            Skill<span>Cert</span>
        </div>

        <a href="/MyCertificates">
            Back to Certificates
        </a>

    </div>


    <div class="page">

        <div class="certificate">

            <div class="certificate-inner">

                <div class="trophy">
                    🏆
                </div>

                <h1>
                    Certificate of Achievement
                </h1>

                <div class="subtitle">
                    SkillCert Online Skill Assessment & Certification
                </div>


                <p class="description">
                    This certificate is proudly awarded for successfully
                    completing the following assessment.
                </p>


                <div class="assessment">
                    @Model.Certificate?.Assessment?.Title
                </div>


                <div class="score">

                    <strong>
                        Score:
                    </strong>

                    @Model.Certificate?.Score /
                    @Model.Certificate?.TotalQuestions

                </div>


                <div class="details">

                    <div class="detail">

                        <strong>
                            Certificate Number
                        </strong>

                        @Model.Certificate?.CertificateNumber

                    </div>


                    <div class="detail">

                        <strong>
                            Issued Date
                        </strong>

                        @Model.Certificate?.IssuedDate.ToString("dd-MM-yyyy")

                    </div>

                </div>


                <div class="buttons">

                    <button
                        onclick="window.print()"
                        class="btn print-btn">

                        🖨 Print Certificate

                    </button>

                    <a
                        href="/MyCertificates"
                        class="btn back-btn">

                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>

</html>