@page
@model SkillAssessmentSystem.Pages.MyCertificatesModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>My Certificates - SkillCert</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #111827;
        }

        /* NAVBAR */

        .navbar {
            background: #172554;
            color: white;
            padding: 18px 8%;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 15px;
        }

        .nav-links a:hover {
            color: #93c5fd;
        }

        /* MAIN */

        .container {
            max-width: 1100px;
            margin: 50px auto;
            padding: 20px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .page-header h1 {
            color: #172554;
            font-size: 36px;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #6b7280;
            font-size: 17px;
        }

        /* CERTIFICATE GRID */

        .certificate-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .certificate-card {
            background: white;
            border-radius: 16px;
            padding: 28px;

            box-shadow: 0 8px 25px rgba(0,0,0,0.08);

            border-top: 5px solid #2563eb;

            transition: transform 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .certificate-card:hover {
            transform: translateY(-5px);

            box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        }

        .certificate-icon {
            width: 65px;
            height: 65px;

            margin-bottom: 18px;

            border-radius: 50%;

            background: #2563eb;
            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 22px;
            font-weight: bold;
        }

        .certificate-card h2 {
            color: #172554;
            margin-bottom: 20px;
        }

        .certificate-info {
            margin-bottom: 20px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;

            padding: 12px 0;

            border-bottom: 1px solid #e5e7eb;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #6b7280;
            font-weight: bold;
        }

        .info-value {
            color: #111827;
            font-weight: 500;
            text-align: right;
        }

        /* BUTTON */

        .view-btn {
            display: inline-block;

            padding: 12px 20px;

            background: #2563eb;
            color: white;

            text-decoration: none;

            border-radius: 8px;

            font-weight: bold;

            margin-top: 10px;
        }

        .view-btn:hover {
            background: #1d4ed8;
        }

        /* EMPTY */

        .empty {
            background: white;

            padding: 60px 30px;

            text-align: center;

            border-radius: 16px;

            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }

        .empty-icon {
            width: 70px;
            height: 70px;

            margin: 0 auto 20px;

            border-radius: 50%;

            background: #e5e7eb;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 22px;
            font-weight: bold;
            color: #6b7280;
        }

        .empty h2 {
            color: #172554;
        }

        .empty p {
            color: #6b7280;
        }

        .assessment-btn {
            display: inline-block;

            margin-top: 15px;

            padding: 12px 22px;

            background: #2563eb;
            color: white;

            text-decoration: none;

            border-radius: 8px;

            font-weight: bold;
        }

        /* FOOTER */

        .footer {
            margin-top: 70px;

            background: #172554;
            color: white;

            text-align: center;

            padding: 20px;
        }

        /* MOBILE */

        @@media (max-width: 800px) {

            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            .nav-links {
                justify-content: center;
            }

            .certificate-grid {
                grid-template-columns: 1fr;
            }

            .container {
                margin: 25px auto;
            }

            .page-header h1 {
                font-size: 30px;
            }
        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">
            SkillCert
        </div>

        <div class="nav-links">

            <a href="/Index">Home</a>

            <a href="/Dashboard">Dashboard</a>

            <a href="/Assessments">Assessments</a>

            <a href="/MyResults">My Results</a>

            <a href="/MyCertificates">Certificates</a>

        </div>

    </nav>


    <!-- MAIN -->

    <div class="container">

        <div class="page-header">

            <h1>My Certificates</h1>

            <p>
                View and verify certificates earned from
                successfully completed assessments.
            </p>

        </div>


        @if (Model.Certificates.Count == 0)
        {
            <div class="empty">

                <div class="empty-icon">
                    CERT
                </div>

                <h2>No Certificates Yet</h2>

                <p>
                    Complete an assessment with a passing score
                    to earn your certificate.
                </p>

                <a href="/Assessments"
                   class="assessment-btn">

                    Take an Assessment

                </a>

            </div>
        }
        else
        {
            <div class="certificate-grid">

                @foreach (var certificate in Model.Certificates)
                {

                    <div class="certificate-card">

                        <div class="certificate-icon">
                            CERT
                        </div>

                        <h2>
                            Certificate of Achievement
                        </h2>


                        <div class="certificate-info">

                            <div class="info-row">

                                <span class="info-label">
                                    Assessment
                                </span>

                                <span class="info-value">
                                    @certificate.Assessment?.Title
                                </span>

                            </div>


                            <div class="info-row">

                                <span class="info-label">
                                    Certificate No.
                                </span>

                                <span class="info-value">
                                    @certificate.CertificateNumber
                                </span>

                            </div>


                            <div class="info-row">

                                <span class="info-label">
                                    Score
                                </span>

                                <span class="info-value">
                                    @certificate.Score /
                                    @certificate.TotalQuestions
                                </span>

                            </div>


                            <div class="info-row">

                                <span class="info-label">
                                    Issued Date
                                </span>

                                <span class="info-value">
    @certificate.IssuedDate.ToString("dd-MM-yyyy")
</span>

                            </div>

                        </div>


                        <a asp-page="/Certificate"
                           asp-route-id="@certificate.CertificateId"
                           class="view-btn">

                            View Certificate

                        </a>

                    </div>

                }

            </div>
        }

    </div>


    <!-- FOOTER -->

    <footer class="footer">

        <p>
            © 2026 SkillCert. All Rights Reserved.
        </p>

    </footer>

</body>
</html>